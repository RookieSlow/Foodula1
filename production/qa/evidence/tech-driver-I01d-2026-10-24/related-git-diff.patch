+            Assert.That(player.driverSkill.UsesRemaining, Is.EqualTo(2));
+        }
+        finally
+        {
+            while (stack.Count > 0) (stack.Pop() as System.IDisposable)?.Dispose();
+            Object.DestroyImmediate(config);
+        }
