    title: "\u5F88\u597D\uFF0C\u73B0\u5728\u8DD1\u4E00\u5708\u7ED9\u6211\u770B\u770B"
    goal: "\u5173\u952E\u673A\u5236\u4F60\u90FD\u4EB2\u624B\u7EC3\u8FC7\u4E86\u3002\u63A5\u4E0B\u6765\u8FD9\u4E00\u5708\u4E0D\u518D\u9650\u5236\u9009\u62E9\uFF0C\u628A\u521A\u5B66\u5230\u7684\u5224\u65AD\u81EA\u7136\u5730\u8FDE\u8D77\u6765\u3002"
    currentState: "\u5929\u6C14\u5DF2\u7ECF\u6062\u590D\u9634\u5929\uFF0C\u521A\u624D\u7528\u4E8E\u6F14\u793A\u7684\u72B6\u6001\u4E0D\u4F1A\u5E26\u8FDB\u81EA\u7531\u7EC3\u4E60\u3002"
    actionPrompt: "\u6700\u540E\u8BB0\u4F4F\u8282\u594F\uFF1A\u6321\u4F4D\u51B3\u5B9A\u5F20\u6570\uFF0C\u901F\u5EA6\u724C\u51B3\u5B9A\u79FB\u52A8\uFF1B\u968F\u540E\u5904\u7406\u70ED\u91CF\u3001\u5F2F\u9053\u3001\u5C3E\u6D41\u4E0E\u5F03\u724C\uFF0C\u9884\u7EA6\u7EF4\u4FEE\u5219\u5728\u4E0B\u4E00\u56DE\u5408\u6267\u884C\u3002"
    successSignal: "\u786E\u8BA4\u540E\u4F1A\u91CD\u5EFA UK \u8D5B\u8F66\u3001\u52D2\u8292\u8D5B\u9053\u3001\u7CBE\u786E\u724C\u7EC4\u548C
      6 \u70ED\u91CF\u3002\u653E\u677E\u4E00\u70B9\uFF0C\u6309\u81EA\u5DF1\u7684\u5224\u65AD\u8DD1\u5B8C\u4E00\u5708\u3002"
    recoveryHint: "\u8BAD\u7EC3\u4E2D\u968F\u65F6\u53EF\u4EE5\u91CD\u65B0\u5F00\u59CB\uFF0C\u4E5F\u53EF\u4EE5\u4ECE\u9762\u677F\u91CD\u64AD\u5F15\u5BFC\u3002\u6559\u7EC3\u4E00\u76F4\u5728\u8FD9\u91CC\u3002"
    focusIntroduction: "\u6574\u573A\u6BD4\u8D5B\u5C31\u662F\u201C\u6321\u4F4D \u2192
      \u624B\u724C \u2192 \u8D5B\u9053\u7ED3\u7B97 \u2192 \u8865\u724C\u201D\u7684\u5FAA\u73AF\u3002\u7A33\u7A33\u8DD1\u597D\u6BCF\u4E00\u4E2A\u56DE\u5408\u3002"
    manualAdvanceLabel: "\u91CD\u7F6E\u5E76\u5F00\u59CB\u7EC3\u4E60"
  previewStep: 0
  practiceTitle: "\u52D2\u8292\u81EA\u7531\u7EC3\u4E60"
  completedTitle: "\u8BAD\u7EC3\u5708\u5B8C\u6210"
  practiceCompletion: "\u2713 \u8D5B\u8F66\u548C\u724C\u7EC4\u90FD\u5DF2\u91CD\u65B0\u51C6\u5907\u597D"
  completedCompletion: "\u2713 \u505A\u5F97\u6F02\u4EAE\uFF0C\u4F60\u5B8C\u6210\u4E86\u6574\u5708\u8BAD\u7EC3"
  practiceInstruction: "\u63A5\u4E0B\u6765\u7531\u4F60\u81EA\u5DF1\u505A\u51B3\u5B9A\u3002\u7528\u51C6\u5907\u597D\u7684
    UK \u8D5B\u8F66\u548C\u6559\u7A0B\u724C\u7EC4\u8DD1\u5B8C\u4E00\u5708\uFF1B\u8FD9\u53EA\u662F\u8BAD\u7EC3\uFF0C\u4E0D\u4F1A\u5F71\u54CD\u6B63\u5E38\u5956\u52B1\u6216\u8D5B\u4E8B\u8FDB\u5EA6\u3002"
  completedInstruction: "\u5F88\u597D\uFF0C\u65B0\u8F66\u624B\u3002\u4F60\u5DF2\u7ECF\u72EC\u7ACB\u5B8C\u6210\u4E00\u6574\u5708\u52D2\u8292\u8BAD\u7EC3\u3002\u8FD9\u91CC\u4E0D\u4F1A\u53D1\u653E
    RP\u3001\u8F66\u624B XP \u6216\u89E3\u9501\uFF1B\u60F3\u518D\u7EC3\u4E00\u5708\u3001\u91CD\u6E29\u5F15\u5BFC\u6216\u56DE\u5230\u4E3B\u83DC\u5355\u90FD\u53EF\u4EE5\u3002"
