  m_Script: {fileID: 11500000, guid: c06e155624724b3eb5aa9ddd6c8e4d78, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  guide: {fileID: 8132375985114034220}
  focusHighlight: {fileID: 8754865668891957359}
  steps:
  - id: 0
    sectionLabel: "\u8D77\u6B65"
    title: "\u6B22\u8FCE\u6765\u5230\u52D2\u8292"
    goal: "\u6B22\u8FCE\u6765\u5230\u56F4\u573A\uFF0C\u65B0\u4EBA\uFF01\u8D5B\u8F66\u56FA\u7136\u523A\u6FC0\uFF0C\u4F46\u9A7E\u9A76\u8D77\u6765\u5E76\u4E0D\u56F0\u96BE\u3002\u4E00\u6B65\u4E00\u6B65\u6765\uFF0C\u4F60\u5C31\u80FD\u6210\u4E3A\u51A0\u519B\u3002"
    currentState: "\u73B0\u5728\uFF0C\u4F60\u6B63\u5728\u9A7E\u9A76\u5C5E\u4E8EUK\u7684\u70B8\u9C7C\u85AF\u6761\u8D5B\u8F66\u3002\u8FD9\u8F86\u4F20\u7EDF\u7684\u8D5B\u8F66\u5F88\u9002\u5408\u4F60\u51A0\u519B\u4E4B\u65C5\u7684\u542F\u7A0B\uFF0C\u5B83\u5177\u6709\u56DB\u4E2A\u6321\u4F4D\uFF0C\u5E76\u6709\u7740\u5747\u8861\u7684\u6027\u80FD\u3002"
    actionPrompt: "\u770B\u770B\u9AD8\u5149\u533A\u57DF\u91CC\u7684\u6BD4\u8D5B\u72B6\u6001\u3002\u51C6\u5907\u597D\u540E\uFF0C\u6211\u4EEC\u5C31\u5F00\u59CB\u4F60\u7684\u7B2C\u4E00\u5708\u5427\u3002"
    successSignal: "\u4E94\u76CF\u7EA2\u706F\u7184\u706D\uFF01\u4F60\u53EF\u4EE5\u4E0A\u624B\u4E86\u3002\u63A5\u4E0B\u6765\u53EA\u9700\u8981\u8DDF\u7740\u201C\u8F6E\u5230\u4F60\u4E86\u201D\u5B8C\u6210\u64CD\u4F5C\u3002"
    recoveryHint: "\u60F3\u770B\u88AB\u9762\u677F\u6321\u4F4F\u7684\u4F4D\u7F6E\uFF0C\u53EF\u5148\u70B9\u201C\u6536\u8D77\u6307\u5F15\u201D\uFF0C\u770B\u5B8C\u518D\u5C55\u5F00\u3002"
    focusIntroduction: "\u6BD4\u8D5B\u72B6\u6001\uFF1A\u8FD9\u91CC\u4F1A\u544A\u8BC9\u4F60\u5F53\u524D\u9636\u6BB5\u3001\u5708\u6570\u548C\u4E0B\u4E00\u4EF6\u8981\u505A\u7684\u4E8B\u3002"
    manualAdvanceLabel: "\u5F00\u59CB\u7B2C\u4E00\u56DE\u5408"
  - id: 1
    sectionLabel: "\u57FA\u7840\u9A7E\u9A76"
    title: "\u8D77\u6B65"
    goal: "\u4E00\u56DE\u5408\u5185\u7684\u64CD\u4F5C\u5F88\u7B80\u5355\uFF1A\u5148\u9009\u6321\uFF0C\u518D\u51FA\u724C\u3002\u8D5B\u8F66\u79FB\u52A8\u540E\u624D\u4F1A\u7ED3\u7B97\u8D5B\u9053\u6548\u679C\uFF0C\u5E76\u8FDB\u884C\u5F03\u724C\u548C\u8865\u724C\u3002"
    currentState: "\u56DE\u5408\u63D0\u793A\u6B63\u5728\u7B49\u4F60\u9009\u62E9\u6321\u4F4D\uFF0C\u8D77\u6B65\u6321\u4F4D\u662F
      G1\u3002"
    actionPrompt: "\u9009 G1\uFF0C\u518D\u9009 1 \u5F20\u901F\u5EA6\u724C\u5E76\u786E\u8BA4\u3002"
    successSignal: "\u63D0\u793A\u4F1A\u4F9D\u6B21\u7ECF\u8FC7\u79FB\u52A8\u3001\u8D5B\u9053\u7ED3\u7B97\u548C\u56DE\u5408\u6E05\u7406\uFF0C\u7136\u540E\u56DE\u5230\u65B0\u56DE\u5408\u3002"
    recoveryHint: "\u6309\u94AE\u6682\u65F6\u4E0D\u53EF\u7528\u901A\u5E38\u4EE3\u8868\u52A8\u753B\u8FD8\u6CA1\u7ED3\u675F\uFF0C\u7B49\u63D0\u793A\u53D8\u5316\u5373\u53EF\u3002"
    focusIntroduction: "\u56DE\u5408\u63D0\u793A\uFF1A\u8FF7\u8DEF\u65F6\u5148\u770B\u8FD9\u91CC\uFF0C\u5B83\u4F1A\u544A\u8BC9\u4F60\u73B0\u5728\u5904\u4E8E\u54EA\u4E2A\u9636\u6BB5\u3002"
    manualAdvanceLabel: 
  - id: 2
    sectionLabel: "\u57FA\u7840\u9A7E\u9A76"
    title: "\u6765\u4E00\u6B21\u6362\u6321"
    goal: "\u6321\u4F4D\u6307\u793A\u4E86\u672C\u56DE\u5408\u5FC5\u987B\u6253\u51FA\u7684\u901F\u5EA6\u724C\u5F20\u6570\uFF1AG2
      \u5C31\u662F 2 \u5F20\u3002\u5982\u679C\u4F60\u9009\u62E9\u4E86\u8FC7\u9AD8\u7684\u6321\u4F4D\u800C\u4E0D\u80FD\u6253\u51FA\u8DB3\u91CF\u7684\u724C\uFF0C\u90A3\u5C31\u4F1A\u53D7\u5230\u60E9\u7F5A\uFF0C\u8FD9\u4E00\u70B9\u6211\u4EEC\u7A0D\u540E\u518D\u8BF4"
    currentState: "\u65B0\u7684\u56DE\u5408\u5DF2\u7ECF\u505C\u5728\u9009\u6321\u9636\u6BB5\uFF0CG2
      \u53EF\u4EE5\u76F4\u63A5\u9009\u62E9\u3002"
    actionPrompt: "\u5148\u70B9 G2\uFF0C\u518D\u4ECE\u624B\u724C\u91CC\u9009 2 \u5F20\u901F\u5EA6\u724C\u5E76\u786E\u8BA4\u3002"
    successSignal: "\u51FA\u724C\u8BA1\u6570\u4F1A\u663E\u793A 2/2\uFF1B\u63A5\u7740\u6211\u4EEC\u89C2\u5BDF\u8FD9\u4E24\u5F20\u724C\u600E\u6837\u9A71\u52A8\u8D5B\u8F66\u3002"
    recoveryHint: "\u591A\u9009\u4E86\u4E00\u5F20\u5C31\u518D\u70B9\u4E00\u6B21\u53D6\u6D88\uFF0C\u7559\u4E0B\u6070\u597D
      2 \u5F20\u5373\u53EF\u3002"
    focusIntroduction: "\u6321\u4F4D\u533A\uFF1A\u6570\u5B57\u540C\u65F6\u51B3\u5B9A\u672C\u56DE\u5408\u9700\u8981\u6253\u51FA\u7684\u901F\u5EA6\u724C\u5F20\u6570\u3002"
    manualAdvanceLabel: 
  - id: 3
    sectionLabel: "\u57FA\u7840\u9A7E\u9A76"
    title: "\u6253\u51FA\u901F\u5EA6\u724C\u8BA9\u8D5B\u8F66\u524D\u8FDB"
    goal: "\u901F\u5EA6\u724C\u5F88\u76F4\u89C2\uFF1A\u672C\u56DE\u5408\u6253\u51FA\u7684\u6570\u5B57\u76F8\u52A0\uFF0C\u5C31\u662F\u8D5B\u8F66\u7684\u57FA\u7840\u79FB\u52A8\u683C\u6570\u3002"
    currentState: "\u521A\u624D\u7684\u4E24\u5F20\u724C\u5DF2\u7ECF\u786E\u8BA4\uFF0C\u8D5B\u8F66\u6B63\u5728\u6309\u5B83\u4EEC\u7684\u603B\u503C\u79FB\u52A8\u3002"
    actionPrompt: "\u8FD9\u4E00\u6B65\u4E0D\u7528\u518D\u70B9\u3002\u89C2\u5BDF\u8D5B\u8F66\u6CBF\u9AD8\u5149\u8D5B\u9053\u9010\u683C\u524D\u8FDB\u3002"
    successSignal: "\u8D5B\u8F66\u843D\u4F4D\u540E\u4F1A\u8BB0\u5F55\u8D77\u70B9\u3001\u7EC8\u70B9\u548C\u603B\u79FB\u52A8\u503C\u3002"
    recoveryHint: "\u955C\u5934\u8FD8\u5728\u8DDF\u8F66\u65F6\u8010\u5FC3\u7B49\u4E00\u4E0B\uFF0C\u843D\u4F4D\u540E\u6559\u7A0B\u4F1A\u81EA\u52A8\u7EE7\u7EED\u3002"
    focusIntroduction: "\u8D5B\u9053\uFF1A\u8D5B\u8F66\u4F1A\u6309\u672C\u56DE\u5408\u901F\u5EA6\u724C\u603B\u548C\u9010\u683C\u524D\u8FDB\uFF0C\u843D\u4F4D\u540E\u518D\u7ED3\u7B97\u8D5B\u9053\u6548\u679C\u3002"
    manualAdvanceLabel: 
  - id: 4
    sectionLabel: "\u5361\u724C\u5FAA\u73AF"
    title: "\u770B\u770B\u724C\u53BB\u4E86\u54EA\u91CC"
    goal: "\u7528\u8FC7\u7684\u724C\u4E0D\u4F1A\u6D88\u5931\uFF1A\u5B83\u4EEC\u8FDB\u5165\u5F03\u724C\u5806\uFF1B\u62BD\u724C\u5806\u7A7A\u65F6\uFF0C\u53EF\u7528\u724C\u4F1A\u6309\u56FA\u5B9A\u987A\u5E8F\u56DE\u5230\u62BD\u724C\u5806\u3002"
    currentState: "\u4E0A\u56DE\u5408\u7684\u901F\u5EA6\u724C\u5DF2\u7ECF\u8FDB\u5165\u5F03\u724C\u5806\uFF0C\u5E95\u90E8\u624B\u724C\u4E5F\u8865\u56DE\u4E86\u4E0A\u9650\u3002"
    actionPrompt: "\u6CBF\u7740\u9AD8\u5149\u533A\u57DF\u770B\u4E00\u904D\u62BD\u724C\u5806\u3001\u5F15\u64CE\u5E93\u548C\u5F03\u724C\u5806\u7684\u6570\u91CF\uFF0C\u968F\u540E\u786E\u8BA4"
    successSignal: "\u4E0B\u4E00\u8BFE\u4F1A\u4E3A\u70ED\u91CF\u673A\u5236\u51C6\u5907\u4E00\u4E2A\u5E72\u51C0\u7684\u724C\u533A\u72B6\u6001\u3002"
    recoveryHint:
    focusIntroduction: "\u724C\u533A\uFF1A\u4ECE\u62BD\u724C\u5806\u62FF\u724C\uFF0C\u7528\u8FC7\u540E\u8FDB\u5F03\u724C\u5806\uFF1B\u5F15\u64CE\u5E93\u53EA\u4FDD\u5B58\u53EF\u652F\u4ED8\u7684\u70ED\u91CF\u3002"
    manualAdvanceLabel: "\u724C\u533A\u5DF2\u770B\u61C2"
  - id: 5
    sectionLabel: "\u70ED\u91CF\u7BA1\u7406"
    title: "\u5927\u5E45\u5347\u6321\u4F1A\u8BA9\u5F15\u64CE\u5347\u6E29"
    goal: "\u4ECE G1 \u76F4\u63A5\u8DF3\u5230 G3 \u5F88\u5FEB\uFF0C\u4F46\u4EE3\u4EF7\u662F\u628A
      1 \u5F20\u5F15\u64CE\u70ED\u91CF\u652F\u4ED8\u5230\u624B\u724C\u3002"
    currentState: "\u8D5B\u8F66\u5DF2\u505C\u5728 24 \u683C\u548C G1\uFF1B\u5F15\u64CE\u5E93\u6709
      6 \u70ED\u91CF\uFF0C\u624B\u724C\u6682\u65F6\u90FD\u662F\u666E\u901A\u724C\u3002"
    actionPrompt: "\u76F4\u63A5\u70B9 G3\uFF0C\u7559\u610F\u9AD8\u5149\u533A\u57DF\u7684\u5F15\u64CE\u6570\u5B57\u600E\u6837\u53D8\u5316\u3002"
    successSignal: "\u5F15\u64CE\u4F1A\u4ECE 6 \u53D8\u6210 5\uFF0C\u624B\u724C\u91CC\u591A\u51FA
      1 \u5F20\u4E0D\u80FD\u5F53\u901F\u5EA6\u4F7F\u7528\u7684\u70ED\u91CF\u724C\u3002"
    recoveryHint: "\u5148\u522B\u51FA\u724C\uFF1B\u82E5\u68C0\u67E5\u70B9\u4ECD\u5728\u843D\u4F4D\uFF0C\u7B49\u6570\u5B57\u7A33\u5B9A\u540E\u518D\u70B9
      G3\u3002"
    focusIntroduction: "\u5F15\u64CE\u5E93\uFF1A\u8FD9\u91CC\u7684\u70ED\u91CF\u662F\u53EF\u652F\u4ED8\u8D44\u6E90\uFF1B\u652F\u4ED8\u540E\u4F1A\u53D8\u6210\u5360\u624B\u724C\u7684\u70ED\u91CF\u724C\u3002"
    manualAdvanceLabel: 
  - id: 6
    sectionLabel: "\u70ED\u91CF\u7BA1\u7406"
    title: "\u4F4E\u6321\u80FD\u628A\u70ED\u91CF\u51B7\u56DE\u5F15\u64CE"
    goal: "\u70ED\u91CF\u724C\u4F1A\u5360\u4F4F\u624B\u724C\u4F4D\u7F6E\uFF0C\u4E5F\u4E0D\u80FD\u62FF\u6765\u79FB\u52A8\uFF1B\u597D\u6D88\u606F\u662F\u4F4E\u6321\u80FD\u5728\u53CD\u5E94\u9636\u6BB5\u628A\u5B83\u51B7\u56DE\u5F15\u64CE\u3002"
    currentState: "\u8D5B\u8F66\u5DF2\u5728 G1\uFF0C\u624B\u724C\u91CC\u6B63\u597D\u6709
