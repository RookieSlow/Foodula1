--- !u!114 &1931934217274176323
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6472711970837619929}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c06e155624724b3eb5aa9ddd6c8e4d78, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  guide: {fileID: 8132375985114034220}
  focusHighlight: {fileID: 8754865668891957359}
  steps:
  - id: 0
    sectionLabel: "\u8D77\u6B65"
    title: "\u6B22\u8FCE\u52A0\u5165\u8F66\u961F"
    goal: "\u6B22\u8FCE\u6765\u5230\u56F4\u573A\uFF0C\u65B0\u8F66\u624B\u3002\u6211\u662F\u4F60\u7684\u6559\u7EC3\uFF0C\u4ECA\u5929\u966A\u4F60\u8DD1\u5B8C\u7B2C\u4E00\u5802\u52D2\u8292\u8BAD\u7EC3\u3002\u522B\u6025\uFF0C\u6211\u4EEC\u4E00\u6B21\u53EA\u7EC3\u4E00\u4E2A\u52A8\u4F5C\u3002"
    currentState: "\u4F60\u9A7E\u9A76\u7684\u662F UK \u70B8\u9C7C\u85AF\u6761\u8D5B\u8F66\u3002\u5B83\u6709\u56DB\u4E2A\u6321\u4F4D\uFF0C\u6027\u80FD\u5747\u8861\uFF0C\u5F88\u9002\u5408\u7528\u6765\u719F\u6089\u6BD4\u8D5B\u8282\u594F\u3002"
    actionPrompt: "\u5148\u770B\u770B\u9AD8\u5149\u91CC\u7684\u6BD4\u8D5B\u72B6\u6001\u3002\u51C6\u5907\u597D\u4E86\uFF0C\u5C31\u548C\u6211\u4E00\u8D77\u5F00\u59CB\u7B2C\u4E00\u56DE\u5408\u3002"
    successSignal: "\u5F88\u597D\uFF0C\u8D5B\u8F66\u5DF2\u7ECF\u5C31\u4F4D\u3002\u4E4B\u540E\u8DDF\u7740\u201C\u8F6E\u5230\u4F60\u4E86\u201D\u64CD\u4F5C\u5C31\u884C\uFF0C\u6211\u4F1A\u5728\u6BCF\u4E2A\u5173\u952E\u70B9\u63D0\u9192\u4F60\u3002"
    recoveryHint: "\u5982\u679C\u9762\u677F\u6321\u4F4F\u4E86\u60F3\u770B\u7684\u4F4D\u7F6E\uFF0C\u53EF\u4EE5\u5148\u6536\u8D77\u6307\u5F15\uFF0C\u770B\u6E05\u540E\u518D\u5C55\u5F00\u3002"
    focusIntroduction: "\u6BD4\u8D5B\u72B6\u6001\u5728\u8FD9\u91CC\u3002\u5B83\u4F1A\u544A\u8BC9\u4F60\u5F53\u524D\u9636\u6BB5\u3001\u5708\u6570\uFF0C\u4EE5\u53CA\u63A5\u4E0B\u6765\u8BE5\u505A\u4EC0\u4E48\u3002"
    manualAdvanceLabel: "\u5F00\u59CB\u7B2C\u4E00\u56DE\u5408"
  - id: 1
    sectionLabel: "\u57FA\u7840\u9A7E\u9A76"
    title: "\u5148\u8DD1\u4E00\u4E2A\u5B8C\u6574\u56DE\u5408"
    goal: "\u5148\u8BB0\u4F4F\u6700\u57FA\u672C\u7684\u8282\u594F\uFF1A\u9009\u6321\u3001\u51FA\u724C\uFF0C\u7136\u540E\u770B\u8D5B\u8F66\u79FB\u52A8\u548C\u8D5B\u9053\u7ED3\u7B97\u3002\u56DE\u5408\u6700\u540E\u624D\u4F1A\u5904\u7406\u5F03\u724C\u4E0E\u8865\u724C\u3002"
    currentState: "\u73B0\u5728\u8F6E\u5230\u4F60\u8D77\u6B65\uFF0CG1 \u662F\u6700\u7A33\u59A5\u7684\u9009\u62E9\u3002"
    actionPrompt: "\u9009\u62E9 G1\uFF0C\u518D\u6311 1 \u5F20\u901F\u5EA6\u724C\u786E\u8BA4\u3002\u6162\u6162\u6765\uFF0C\u5148\u628A\u5B8C\u6574\u6D41\u7A0B\u8D70\u4E00\u904D\u3002"
    successSignal: "\u505A\u5F97\u597D\u3002\u8D5B\u8F66\u4F1A\u5B8C\u6210\u79FB\u52A8\u3001\u8D5B\u9053\u7ED3\u7B97\u548C\u56DE\u5408\u6E05\u7406\uFF0C\u7136\u540E\u56DE\u5230\u65B0\u7684\u56DE\u5408\u3002"
    recoveryHint: "\u6309\u94AE\u6682\u65F6\u4E0D\u80FD\u70B9\u65F6\uFF0C\u901A\u5E38\u53EA\u662F\u52A8\u753B\u8FD8\u5728\u64AD\u653E\uFF0C\u7B49\u56DE\u5408\u63D0\u793A\u66F4\u65B0\u5373\u53EF\u3002"
    focusIntroduction: "\u56DE\u5408\u63D0\u793A\u5C31\u50CF\u6211\u4EEC\u7684\u6218\u672F\u677F\u3002\u62FF\u4E0D\u51C6\u4E0B\u4E00\u6B65\u65F6\uFF0C\u5148\u770B\u8FD9\u91CC\u3002"
    manualAdvanceLabel: 
  - id: 2
    sectionLabel: "\u57FA\u7840\u9A7E\u9A76"
    title: "\u8BD5\u7740\u5347\u5230 G2"
    goal: "\u6321\u4F4D\u51B3\u5B9A\u672C\u56DE\u5408\u9700\u8981\u6253\u51FA\u7684\u901F\u5EA6\u724C\u5F20\u6570\uFF1AG2
      \u5C31\u8981\u6253 2 \u5F20\u3002\u6321\u4F4D\u8D8A\u9AD8\uFF0C\u9009\u62E9\u8D8A\u5927\u80C6\uFF0C\u4E5F\u8D8A\u9700\u8981\u786E\u4FDD\u624B\u724C\u8DDF\u5F97\u4E0A\u3002"
    currentState: "\u65B0\u56DE\u5408\u5DF2\u7ECF\u51C6\u5907\u597D\uFF0C\u6211\u4EEC\u6765\u7EC3\u4E00\u6B21\u7A33\u7A33\u7684\u5347\u6321\u3002"
    actionPrompt: "\u9009\u62E9 G2\uFF0C\u518D\u4ECE\u624B\u724C\u4E2D\u6311 2 \u5F20\u901F\u5EA6\u724C\u786E\u8BA4\u3002"
    successSignal: "\u770B\u5230 2/2 \u5C31\u8BF4\u660E\u914D\u5408\u6B63\u786E\u3002\u63A5\u4E0B\u6765\u4E00\u8D77\u770B\u770B\u5B83\u4EEC\u600E\u6837\u63A8\u52A8\u8D5B\u8F66\u3002"
    recoveryHint: "\u5982\u679C\u4E0D\u5C0F\u5FC3\u591A\u9009\u4E86\uFF0C\u518D\u70B9\u4E00\u6B21\u90A3\u5F20\u724C\u5C31\u80FD\u53D6\u6D88\u3002\u7559\u4E0B\u6B63\u597D
      2 \u5F20\u5373\u53EF\u3002"
    focusIntroduction: "\u6321\u4F4D\u533A\u5728\u8FD9\u91CC\u3002\u6321\u4F4D\u6570\u5B57\uFF0C\u5C31\u662F\u672C\u56DE\u5408\u8981\u6253\u51FA\u7684\u901F\u5EA6\u724C\u5F20\u6570\u3002"
    manualAdvanceLabel: 
  - id: 3
    sectionLabel: "\u57FA\u7840\u9A7E\u9A76"
    title: "\u770B\u770B\u901F\u5EA6\u600E\u6837\u53D8\u6210\u8DDD\u79BB"
    goal: "\u901F\u5EA6\u724C\u4E0A\u7684\u6570\u5B57\u4F1A\u76F8\u52A0\uFF0C\u5408\u8BA1\u503C\u5C31\u662F\u8D5B\u8F66\u8FD9\u4E00\u56DE\u5408\u7684\u57FA\u7840\u79FB\u52A8\u683C\u6570\u3002\u89C4\u5219\u4E0D\u590D\u6742\uFF0C\u5173\u952E\u662F\u5B66\u4F1A\u4F30\u7B97\u843D\u70B9\u3002"
    currentState: "\u4F60\u521A\u624D\u9009\u7684\u4E24\u5F20\u724C\u5DF2\u7ECF\u786E\u8BA4\uFF0C\u8D5B\u8F66\u6B63\u5728\u6267\u884C\u8FD9\u6B21\u79FB\u52A8\u3002"
    actionPrompt: "\u8FD9\u4E00\u6B65\u4E0D\u7528\u64CD\u4F5C\uFF0C\u8DDF\u7740\u955C\u5934\u89C2\u5BDF\u8D5B\u8F66\u6CBF\u8D5B\u9053\u524D\u8FDB\u3002"
    successSignal: "\u8D5B\u8F66\u843D\u4F4D\u540E\uFF0C\u6211\u4EEC\u5C31\u80FD\u770B\u5230\u8FD9\u7EC4\u901F\u5EA6\u724C\u5E26\u6765\u7684\u5B9E\u9645\u8DDD\u79BB\u3002"
    recoveryHint: "\u955C\u5934\u8FD8\u5728\u8DDF\u8F66\u65F6\u7A0D\u7B49\u4E00\u4E0B\uFF0C\u8D5B\u8F66\u505C\u7A33\u540E\u8BAD\u7EC3\u4F1A\u81EA\u52A8\u7EE7\u7EED\u3002"
    focusIntroduction: "\u770B\u8D5B\u9053\u4E0A\u7684\u843D\u70B9\u3002\u8D5B\u8F66\u5148\u6309\u901F\u5EA6\u603B\u548C\u524D\u8FDB\uFF0C\u505C\u7A33\u540E\u624D\u7ED3\u7B97\u8D5B\u9053\u6548\u679C\u3002"
    manualAdvanceLabel: 
  - id: 4
    sectionLabel: "\u5361\u724C\u5FAA\u73AF"
    title: "\u6574\u7406\u4E00\u4E0B\u6211\u4EEC\u7684\u724C\u533A"
    goal: "\u7528\u8FC7\u7684\u724C\u4E0D\u4F1A\u4E22\u5931\uFF0C\u5B83\u4EEC\u4F1A\u8FDB\u5165\u5F03\u724C\u5806\u3002\u62BD\u724C\u5806\u7528\u5B8C\u540E\uFF0C\u53EF\u7528\u724C\u4F1A\u91CD\u65B0\u56DE\u5230\u62BD\u724C\u5806\uFF0C\u7EE7\u7EED\u4E3A\u540E\u9762\u7684\u56DE\u5408\u670D\u52A1\u3002"
    currentState: "\u521A\u624D\u6253\u51FA\u7684\u901F\u5EA6\u724C\u5DF2\u7ECF\u6536\u8FDB\u5F03\u724C\u5806\uFF0C\u624B\u724C\u4E5F\u8865\u56DE\u4E86\u4E0A\u9650\u3002"
    actionPrompt: "\u770B\u770B\u9AD8\u5149\u533A\u57DF\u91CC\u7684\u62BD\u724C\u5806\u3001\u5F15\u64CE\u5E93\u548C\u5F03\u724C\u5806\u6570\u91CF\u3002\u770B\u660E\u767D\u540E\u544A\u8BC9\u6211\uFF0C\u6211\u4EEC\u7EE7\u7EED\u3002"
    successSignal: "\u5F88\u597D\u3002\u63A5\u4E0B\u6765\u6211\u4F1A\u628A\u724C\u533A\u6574\u7406\u597D\uFF0C\u5E26\u4F60\u8BA4\u8BC6\u5F15\u64CE\u70ED\u91CF\u3002"
    recoveryHint:
    focusIntroduction: "\u8FD9\u662F\u724C\u533A\uFF1A\u724C\u4ECE\u62BD\u724C\u5806\u6765\u5230\u624B\u4E2D\uFF0C\u7528\u8FC7\u540E\u8FDB\u5165\u5F03\u724C\u5806\uFF1B\u5F15\u64CE\u5E93\u4FDD\u5B58\u53EF\u652F\u4ED8\u7684\u70ED\u91CF\u3002"
    manualAdvanceLabel: "\u724C\u533A\u5DF2\u770B\u61C2"
  - id: 5
    sectionLabel: "\u70ED\u91CF\u7BA1\u7406"
    title: "\u5927\u80C6\u5347\u6321\uFF0C\u4E5F\u8981\u7167\u987E\u5F15\u64CE"
    goal: "\u4ECE G1 \u76F4\u63A5\u5347\u5230 G3 \u80FD\u5FEB\u901F\u63D0\u901F\uFF0C\u4F46\u5F15\u64CE\u8981\u4E3A\u8FD9\u6B21\u5927\u5E45\u6362\u6321\u652F\u4ED8
      1 \u70ED\u91CF\u3002\u652F\u4ED8\u540E\u7684\u70ED\u91CF\u724C\u4F1A\u8FDB\u5165\u624B\u724C\u3002"
    currentState: "\u8D5B\u8F66\u5DF2\u7ECF\u505C\u5728 24 \u683C\u548C G1\uFF0C\u5F15\u64CE\u5E93\u6709
      6 \u70ED\u91CF\uFF0C\u624B\u724C\u72B6\u6001\u4E5F\u51C6\u5907\u597D\u4E86\u3002"
    actionPrompt: "\u8FD9\u6B21\u76F4\u63A5\u9009\u62E9 G3\uFF0C\u6CE8\u610F\u89C2\u5BDF\u9AD8\u5149\u4E2D\u7684\u5F15\u64CE\u6570\u5B57\u3002"
    successSignal: "\u4F60\u4F1A\u770B\u5230\u5F15\u64CE\u4ECE 6 \u53D8\u6210 5\uFF0C\u624B\u724C\u91CC\u591A\u51FA
      1 \u5F20\u4E0D\u80FD\u7528\u6765\u79FB\u52A8\u7684\u70ED\u91CF\u724C\u3002"
    recoveryHint: "\u5982\u679C\u8D5B\u8F66\u548C\u6570\u5B57\u8FD8\u5728\u8C03\u6574\uFF0C\u5148\u7B49\u753B\u9762\u7A33\u5B9A\uFF0C\u518D\u9009\u62E9
      G3\u3002"
    focusIntroduction: "\u8FD9\u91CC\u662F\u5F15\u64CE\u5E93\u3002\u53EF\u7528\u70ED\u91CF\u4ECE\u8FD9\u91CC\u652F\u4ED8\uFF0C\u652F\u4ED8\u540E\u5C31\u4F1A\u53D8\u6210\u5360\u7528\u624B\u724C\u7684\u70ED\u91CF\u724C\u3002"
    manualAdvanceLabel: 
  - id: 6
